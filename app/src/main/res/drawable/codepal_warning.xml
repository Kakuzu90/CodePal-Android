<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Light background -->
    <solid android:color="@color/warning_color" /> <!-- very light yellow -->

    <!-- Darker border -->
    <stroke
        android:width="2dp"
        android:color="@color/warning_border" /> <!-- amber border -->

    <!-- Rounded corners -->
    <corners android:radius="12dp" />

    <!-- Padding inside box -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp"/>
</shape>
